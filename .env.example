# Copy to .env and fill in. Never commit .env — it is gitignored and the
# pre-commit hook runs gitleaks over staged changes.

# --- Core ---
NODE_ENV=development
# Reported by both /health endpoints and shown on /status. A version that never
# changes is a version nobody can use to tell two deploys apart.
APP_VERSION=0.1.0

# --- Database (Postgres) ---
# Published on 5438 to avoid clashing with a host PostgreSQL on 5432 and with the
# other portfolio stacks on 5433-5437.
DATABASE_URL=postgresql://chat:chat@localhost:5438/chat?schema=public
# Direct (unpooled) connection, used only by `prisma migrate`. Locally this is the
# same value; behind a transaction-mode pooler it is the provider's direct URL,
# because migrations cannot run through one.
DIRECT_DATABASE_URL=postgresql://chat:chat@localhost:5438/chat?schema=public

# --- Redis ---
# Four jobs: the Socket.io adapter's pub/sub (which is what lets two gateway
# processes serve one channel), the presence roster, the typing set, and rate
# limiting. Nothing durable lives here -- every message is in Postgres before it
# is broadcast.
REDIS_URL=redis://localhost:6385

# --- API service (REST) ---
API_PORT=4000
# Server-to-server base URL, used by the web app's server components.
API_BASE_URL=http://localhost:4000

# --- Realtime service (WebSocket) ---
# A separate process from the API on purpose: the send path lives in
# services/messaging and both processes call it, so the socket server is not a
# thin relay in front of the API and a message costs one hop rather than two.
REALTIME_PORT=4100
# The container override, and the reason the second replica needs no second image.
#
# Both gateway processes are built from infra/Dockerfile.realtime and run the same
# `node dist/main.js`. `PORT` wins over `REALTIME_PORT` in apps/realtime/src/config.ts,
# so infra/docker-compose.yml's `realtime-2` service sets PORT=4101 and gets a second
# replica out of the image the first one already built. Left blank here because a
# host running `pnpm dev` wants REALTIME_PORT; setting PORT locally would also move
# the API, which reads it with the same precedence.
PORT=
# Server-to-server, for the /status page's health probe.
REALTIME_BASE_URL=http://localhost:4100
# A second gateway replica, when one is running. The gateway is the process that
# scales horizontally: several replicas serve one channel through the Socket.io
# Redis adapter. `docker compose --profile app up` starts one on 4101, and
# scripts/integration.sh starts one to prove that a message sent through 4100
# reaches a client on 4101 -- with a single process that assertion is vacuous,
# because both clients would sit on the same in-memory adapter. Leave it as is for
# a single-replica setup; nothing breaks if that replica is not running.
REALTIME_BASE_URL_2=http://localhost:4101
# Browser-visible socket URL. Baked into the client bundle at build time.
NEXT_PUBLIC_REALTIME_URL=http://localhost:4100

# --- Web app ---
WEB_PORT=3000
APP_BASE_URL=http://localhost:3000
# Browser-visible API URL. Baked at build time by infra/Dockerfile.web.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# --- Auth ---
# Shared by web (Auth.js session + service-token minting), api (token
# verification) and realtime (socket handshake verification). All three verify
# the same HS256 signature, which is what lets the socket handshake reuse the
# token the REST client already carries. Must be >= 16 chars.
# Generate: openssl rand -base64 32
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# --- Ordering ---
# Every message in a channel gets a gapless `seq`, allocated inside the send
# transaction by `UPDATE channels SET next_seq = next_seq + 1 RETURNING next_seq`.
# That statement takes a row lock, so two concurrent sends to one channel
# serialise rather than racing; a `serializable` retry is still possible under
# contention, and this is how many times the send is replayed before it gives up
# with a named error instead of spinning.
SEND_RETRY_ATTEMPTS=5

# --- History ---
# Messages per page, read by keyset on `seq` rather than by OFFSET: a message
# arriving mid-scroll must not shift the page under the reader's thumb.
HISTORY_PAGE_SIZE=40
# The ceiling on a reconnect catch-up. A client that was away for a week asks for
# everything it missed; past this many messages the server tells it to reload the
# channel instead of streaming a day of backlog through a socket.
CATCHUP_MAX_MESSAGES=200

# --- Presence ---
# A client refreshes its roster entry every PRESENCE_HEARTBEAT_SECONDS; the entry
# expires PRESENCE_TTL_SECONDS after the last refresh. The TTL is deliberately
# more than twice the heartbeat: at exactly 2x, one dropped packet marks somebody
# offline who is still reading, and a roster that flickers is worse than one that
# is a few seconds stale.
PRESENCE_HEARTBEAT_SECONDS=10
PRESENCE_TTL_SECONDS=25
# How long "X is typing" survives without a refresh. Short on purpose: a typing
# indicator that outlives the typing is a lie about who is in the conversation.
TYPING_TTL_SECONDS=5

# --- Socket limits ---
# Largest accepted socket frame, in bytes (64 KB). A message body is capped far
# below this by the contract; the ceiling stops a single client from pinning a
# gateway with a payload nobody asked for. Attachments never travel over the
# socket -- they go through the API's upload route.
SOCKET_MAX_PAYLOAD_BYTES=65536
# Events per minute per socket. Typing pings are the loud one: they are throttled
# client-side to one every few seconds, so 240 leaves room for a fast
# conversation without leaving room for a loop.
SOCKET_EVENT_RATE_LIMIT=240

# --- Uploads ---
# Local disk, deliberately: this portfolio publishes to GitHub and hosts nothing,
# so an S3 bucket would be a credential in an .env nobody can use. The directory
# is gitignored; the API serves from it behind the session, never as static files.
UPLOAD_DIR=var/uploads
# 10 MB. Enforced by byte count while streaming, not by trusting Content-Length.
UPLOAD_MAX_BYTES=10485760

# --- Rate limits (requests per minute, per client IP) ---
RATE_LIMIT_GLOBAL=240
RATE_LIMIT_AUTH=5
