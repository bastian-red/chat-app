# dependencies
node_modules/
.pnpm-store/

# builds
dist/
build/
.next/
out/
*.tsbuildinfo

# env
.env
.env.*
!.env.example

# test / coverage
coverage/
playwright-report/
test-results/
.turbo/

# local-only (never published)
docs/

# logs
*.log
npm-debug.log*

# os
.DS_Store

# Prisma client is generated into the package (see schema.prisma) and rebuilt
# by `pnpm db:generate`; it is a build output, not source.
packages/db/generated/

# Demo GIF frames are regenerated by scripts/demo-gif.sh; only the GIF is committed.
e2e/demo-shots/

# Uploaded attachments. `UPLOAD_DIR` defaults to `var/uploads` and the API creates
# it at boot, so a repo that ran the test suite once has files here. They are
# binaries somebody else uploaded, they are reproducible by running the app, and
# committing them would put arbitrary bytes from a test run into the history.
var/
