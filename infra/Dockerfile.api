# syntax=docker/dockerfile:1.7
#
# Multi-stage build for @chat/api (NestJS 10 on @nestjs/platform-express).
#
# Build from the REPO ROOT, not from infra/, so the build context contains the
# whole workspace (pnpm-lock.yaml, every package @chat/api depends on):
#   docker build -f infra/Dockerfile.api -t chat-api .
#
# Five stages, each earning its own cache boundary:
#   base       -- the OS packages every later stage needs, once.
#   fetch      -- populates pnpm's content-addressable store from the lockfile
#                 alone. Cache key is pnpm-lock.yaml; untouched by source edits.
#   build      -- full workspace source, installed offline, compiled.
#   prod-deps  -- pnpm's own "deploy": only @chat/api's production dependencies,
#                 as real files, in one directory.
#   runtime    -- the shipped image. Never sees a devDependency, source, or the
#                 rest of the monorepo.

FROM node:20-bookworm-slim AS base
# Prisma's query engine binary dynamically links against libssl, and
# bookworm-slim ships neither openssl nor ca-certificates. Missing this fails two
# different ways depending on the stage: `prisma generate` cannot verify its
# download, and the compiled engine refuses to load at container start with
# "library libssl.so.3 not found" -- a runtime crash with no build-time signal.
RUN apt-get update -qq \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
# pnpm is not preinstalled on node:20-bookworm-slim. corepack is, and pinning the
# exact version here keeps the image's package manager identical to the one
# pnpm-lock.yaml was written by.
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /repo

# --- fetch -----------------------------------------------------------------
FROM base AS fetch
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
# --ignore-scripts: `pnpm fetch` populates the store by installing into a
# throwaway virtual store, which runs postinstall for every package that has one
# -- including simple-git-hooks, a ROOT devDependency with nothing to do with
# @chat/api. Its bundled postinstall.js walks up looking for the nearest
# package.json, which this stage has not copied (only the lockfile has, on
# purpose, so this layer's cache key stays the lockfile alone), and crashes the
# whole fetch with ENOENT. The one script the build genuinely depends on --
# `prisma generate` -- is invoked explicitly further down.
RUN pnpm fetch --ignore-scripts

# --- build -----------------------------------------------------------------
FROM fetch AS build
COPY . .
# --offline forces resolution from the store `pnpm fetch` already populated from
# the lockfile, so a change to application code can never silently pull a
# dependency version the lockfile does not pin.
RUN pnpm install --frozen-lockfile --offline --ignore-scripts
# Explicit first step so a schema error reports as "prisma generate failed" and
# not as a wall of downstream type errors.
RUN pnpm --filter @chat/db run generate
# turbo, not a bare `pnpm --filter @chat/api build`: the API imports @chat/db,
# @chat/shared, @chat/messaging and @chat/presence through
# their compiled dist/ output, and a bare filtered build only runs @chat/api's
# own script, leaving those unbuilt. The trailing `...` walks the dependency
# graph turbo.json already encodes.
RUN pnpm exec turbo run build --filter=@chat/api...

# --- prod-deps -------------------------------------------------------------
FROM build AS prod-deps
RUN pnpm --filter @chat/api deploy --prod /prod/api
# Guards the one fact the runtime CMD depends on. A silent absence here would
# otherwise surface only as "Cannot find module" on the container's first start.
RUN test -f /prod/api/dist/main.js || \
  (echo "prod-deps: /prod/api/dist/main.js is missing after pnpm deploy. apps/api/src/main.ts either does not exist or failed to compile." >&2 && exit 1)

# --- runtime ---------------------------------------------------------------
FROM node:20-bookworm-slim AS runtime
RUN apt-get update -qq \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && groupadd --gid 1001 chat \
  && useradd --uid 1001 --gid chat --shell /usr/sbin/nologin --no-create-home chat
WORKDIR /app
COPY --from=prod-deps --chown=chat:chat /prod/api ./
# UPLOAD_DIR defaults to the relative path `var/uploads` (.env.example), which
# resolves under this WORKDIR. /health checks that directory is WRITABLE, not
# merely configured, so without this the container starts, answers 503 forever,
# and compose's `depends_on: service_healthy` never releases the web container.
# Created and owned here rather than at boot because the process runs as an
# unprivileged user that cannot create a directory under a root-owned /app.
RUN mkdir -p /app/var/uploads && chown -R chat:chat /app/var
# Not a named volume in this file: uploads are demo data, and a volume would make
# `docker compose --profile app down && up` silently keep files whose rows the
# reseeded database no longer has.
VOLUME ["/app/var/uploads"]
USER chat
ENV NODE_ENV=production
EXPOSE 4000
# PORT wins over API_PORT in apps/api/src/config (the name every container
# runtime injects), so the healthcheck honours the same precedence rather than
# assuming the EXPOSEd default is what the process actually bound. /health
# reports 503, not a thrown error, when a dependency is down, so this reads the
# status code instead of requiring a 2xx.
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "require('http').get('http://127.0.0.1:'+(process.env.PORT||process.env.API_PORT||4000)+'/health',(r)=>process.exit(r.statusCode<500?0:1)).on('error',()=>process.exit(1))"
CMD ["node", "dist/main.js"]
