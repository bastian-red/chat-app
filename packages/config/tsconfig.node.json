{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    // Node16, not CommonJS + Node. The classic `Node` resolver predates the
    // `exports` field and cannot see a subpath: `@chat/shared/server` resolves at
    // runtime and fails to typecheck, with TypeScript reporting that the types
    // exist but "could not be resolved under your current moduleResolution
    // setting". That subpath is not optional — it is the boundary that keeps
    // `node:crypto` out of the browser bundle.
    //
    // Emit is unchanged: none of these packages sets `"type": "module"`, so Node16
    // compiles them as CommonJS, and relative imports still need no file
    // extension.
    //
    // CommonJS emit is also why no package here may depend on an ESM-only
    // library. `require()` of one throws ERR_REQUIRE_ESM at runtime rather than
    // at build, so the failure lands in a running gateway instead of in CI. The
    // concrete case avoided: `file-type`, the obvious way to sniff an upload's
    // content type from its bytes, went ESM-only at v19. `apps/api` reads the
    // magic numbers itself instead -- a dozen lines with a unit test, against a
    // dependency that would fail in production and nowhere else.
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "lib": ["ES2023"],
    "types": ["node"],
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true
  }
}
